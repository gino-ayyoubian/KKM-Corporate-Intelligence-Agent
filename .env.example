# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model identifier (defaults to gemini-flash-latest).
GEMINI_MODEL="gemini-flash-latest"

# KKM_API_TOKEN: Required outside development; set a unique random value in a secret manager.
# The prototype uses one shared bearer token and does not provide per-user roles or SSO.

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
